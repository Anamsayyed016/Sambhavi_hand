# PostgreSQL connection string for Prisma
# Example: postgresql://USER:PASSWORD@HOST:5432/sambhavi?schema=public
DATABASE_URL=

# Required: random secret used when hashing admin session tokens (min 32 chars recommended)
ADMIN_SESSION_SECRET=

# One-time bootstrap only (pnpm admin:create) — do not commit real values
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_NAME=

# Razorpay — real Checkout (no mocks). Server-only except KEY_ID returned to the browser.
# Use LIVE keys (rzp_live_…) for real charges; TEST keys (rzp_test_…) for sandbox only.
# Never prefix KEY_SECRET or WEBHOOK_SECRET with NEXT_PUBLIC_. Never commit real values.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Optional but recommended for payment.captured / payment.failed reliability
RAZORPAY_WEBHOOK_SECRET=

# Public site URL (used in admin “View Order” email links)
# Example: https://sambhavihandloom.com
NEXT_PUBLIC_SITE_URL=

# Order notification emails (never fail checkout if email is misconfigured)
# Recipient for admin new-order alerts (falls back to StoreSettings.storeEmail / ADMIN_EMAIL)
ADMIN_ORDER_EMAIL=
EMAIL_FROM=

# Option A — Resend
RESEND_API_KEY=

# Option B — SMTP
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
# SMTP_SECURE=true  # set for port 465

# Cloudflare R2 — server-only product image uploads (never use NEXT_PUBLIC_ for these)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=sambhavihandloom
R2_PUBLIC_BASE_URL=https://images.sambhaviheritagereimagined.com

