# PostgreSQL connection string for Prisma
# Example: postgresql://USER:PASSWORD@HOST:5432/sambhavi?schema=public
DATABASE_URL=

# Required: random secret used when hashing admin session tokens (min 32 chars recommended)
ADMIN_SESSION_SECRET=

# One-time bootstrap only (pnpm admin:create) — do not commit real values
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_NAME=
