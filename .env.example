# PostgreSQL connection string for Prisma
# Example: postgresql://USER:PASSWORD@HOST:5432/sambhavi?schema=public
DATABASE_URL=

# Required: random secret used when hashing admin session tokens (min 32 chars recommended)
ADMIN_SESSION_SECRET=

# One-time bootstrap only (pnpm admin:create) — do not commit real values
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_NAME=

# Razorpay — real Checkout (no mocks). Server-only except KEY_ID returned to the browser.
# Use LIVE keys (rzp_live_…) for real charges; TEST keys (rzp_test_…) for sandbox only.
# Never prefix KEY_SECRET or WEBHOOK_SECRET with NEXT_PUBLIC_. Never commit real values.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Optional but recommended for payment.captured / payment.failed reliability
RAZORPAY_WEBHOOK_SECRET=
