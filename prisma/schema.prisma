// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum ProductAvailability {
  IN_STOCK
  LOW_STOCK
  MADE_TO_ORDER
}

enum OrderStatus {
  PENDING
  CONFIRMED
  PROCESSING
  SHIPPED
  DELIVERED
  CANCELLED
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
  REFUNDED
}

enum DiscountType {
  PERCENTAGE
  FIXED
}

enum NotificationType {
  NEW_ORDER
  LOW_STOCK
  PAYMENT_ISSUE
  SYSTEM
}

/// Catalog products. Seeded from lib/products.ts — frontend still reads that file in Phase 2.
model Product {
  id           String              @id @default(cuid())
  slug         String              @unique
  sku          String              @unique
  name         String
  description  String
  /// Price in INR rupees (integer), matching existing storefront values
  price        Int
  originalPrice Int?
  image        String
  images       String[]
  category     String
  /// Collection slugs matching lib/content.ts (e.g. silk-sarees, new-arrivals)
  collections  String[]
  fabric       String
  weave        String
  length       String
  blouse       String
  care         String
  availability ProductAvailability
  isNew        Boolean             @default(false)
  /// Provisional until real inventory is set in admin (see seed docs)
  stock        Int                 @default(0)
  active       Boolean             @default(true)
  featured     Boolean             @default(false)
  createdAt    DateTime            @default(now())
  updatedAt    DateTime            @updatedAt
  orderItems   OrderItem[]

  @@index([category])
  @@index([active])
  @@index([featured])
}

/// Collection metadata from lib/content.ts. Products link via Product.collections slug array.
model Collection {
  id          String   @id @default(cuid())
  slug        String   @unique
  name        String
  description String
  image       String
  active      Boolean  @default(true)
  featured    Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([active])
  @@index([featured])
}

model Order {
  id              String        @id @default(cuid())
  orderNumber     String        @unique
  status          OrderStatus   @default(PENDING)
  paymentStatus   PaymentStatus @default(PENDING)
  subtotal        Int
  shipping        Int
  total           Int
  currency        String        @default("INR")
  customerName    String
  customerEmail   String
  customerPhone   String
  shippingAddress String
  city            String
  state           String
  postalCode      String
  country         String        @default("IN")
  paymentMethod   String?
  paymentId       String?
  razorpayOrderId String?       @unique
  notes           String?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  items           OrderItem[]

  @@index([status])
  @@index([paymentStatus])
  @@index([customerEmail])
}

model OrderItem {
  id           String  @id @default(cuid())
  orderId      String
  productId    String?
  productSlug  String
  productName  String
  /// Snapshot image URL at time of order (survives catalog changes)
  productImage String?
  /// Snapshot unit price in INR at time of order
  price        Int
  quantity     Int
  subtotal     Int
  order        Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product      Product? @relation(fields: [productId], references: [id], onDelete: SetNull)

  @@index([orderId])
  @@index([productId])
}

model ContactSubmission {
  id        String   @id @default(cuid())
  name      String
  email     String
  subject   String
  message   String
  createdAt DateTime @default(now())

  @@index([email])
  @@index([createdAt])
}

model NewsletterSubscriber {
  id           String   @id @default(cuid())
  email        String   @unique
  active       Boolean  @default(true)
  subscribedAt DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

/// Admin-only authentication. Separate from any future customer accounts.
model AdminUser {
  id           String         @id @default(cuid())
  email        String         @unique
  passwordHash String
  name         String
  active       Boolean        @default(true)
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt
  sessions     AdminSession[]

  @@index([active])
}

/// Server-side admin sessions. Cookie stores raw token; DB stores tokenHash only.
model AdminSession {
  id          String    @id @default(cuid())
  adminUserId String
  tokenHash   String    @unique
  expiresAt   DateTime
  createdAt   DateTime  @default(now())
  adminUser   AdminUser @relation(fields: [adminUserId], references: [id], onDelete: Cascade)

  @@index([adminUserId])
  @@index([expiresAt])
}

/// Discount coupons — not auto-applied at checkout until integration phase.
model Coupon {
  id              String       @id @default(cuid())
  code            String       @unique
  discountType    DiscountType
  /// Percentage 1–100 or fixed INR amount
  discountValue   Int
  minOrderValue   Int?
  maxDiscount     Int?
  startsAt        DateTime?
  expiresAt       DateTime?
  usageLimit      Int?
  usageCount      Int          @default(0)
  active          Boolean      @default(true)
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  @@index([active])
  @@index([expiresAt])
}

/// Singleton store configuration (id = "default").
model StoreSettings {
  id                    String   @id @default("default")
  storeName             String   @default("Sambhavi Handloom")
  storeEmail            String   @default("")
  storePhone            String   @default("")
  storeAddress          String   @default("")
  currency              String   @default("INR")
  timezone              String   @default("Asia/Kolkata")
  shippingFee           Int      @default(149)
  freeShippingThreshold Int      @default(9999)
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt
}

model AdminNotification {
  id        String           @id @default(cuid())
  type      NotificationType
  title     String
  message   String
  link      String?
  /// Optional link to the related Order (for NEW_ORDER / PAYMENT_ISSUE)
  orderId   String?
  read      Boolean          @default(false)
  createdAt DateTime         @default(now())

  @@index([read, createdAt])
  @@index([orderId])
}
